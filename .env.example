# Database
DATABASE_URL="your_neon_database_connection_string_here"
# Optional direct connection for Prisma migrations and other schema-changing CLI commands.
# Use the non-pooler Neon hostname here when available.
DIRECT_DATABASE_URL="your_neon_direct_database_connection_string_here"

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# JWT Secret for authentication
JWT_SECRET="your-jwt-secret-key-here"

# Public base URL used to build OAuth redirect URIs.
APP_BASE_URL=http://localhost:3000

# Social sign-in (public users only). Leave a pair blank to hide that button.
# Redirect URIs to register with each provider:
#   {APP_BASE_URL}/api/auth/oauth/google/callback
#   {APP_BASE_URL}/api/auth/oauth/facebook/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=


# Session timeout configuration
# Absolute session lifetime in seconds (default: 8 hours)
NEXT_PUBLIC_AUTH_SESSION_MAX_AGE_SECONDS=28800
# Idle timeout in milliseconds before automatic logout (default: 2 hours)
NEXT_PUBLIC_AUTH_IDLE_TIMEOUT_MS=7200000
# How often the client revalidates the current session with the server (default: 1 minute)
NEXT_PUBLIC_AUTH_REVALIDATION_MS=60000

# Google Maps API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
# IMPORTANT: Never commit real API keys to version control
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Server-side key for Google geocoding operations
GOOGLE_MAPS_SERVER_API_KEY=your_server_side_api_key_here

# Optional dedicated server-side key for Google Routes fallback.
# Use this when you want a separate key for routes.googleapis.com.
# Do not apply HTTP referrer restrictions to this key because route calculation
# happens on the server, not directly in the browser.
GOOGLE_ROUTES_API_KEY=your_google_routes_server_api_key_here

# OpenRouteService timeout in milliseconds before GPS fallback is used
ROUTING_ORS_TIMEOUT_MS=3500

# Google Routes timeout in milliseconds before the fallback is treated as unavailable
ROUTING_GOOGLE_ROUTES_TIMEOUT_MS=3500
# How far ORS may look for a road when snapping a coordinate (metres).
# ORS defaults to 350 m and rejects anything further with error 2010; most of
# Basey's barangay coordinates are polygon centroids well beyond that.
ROUTING_SNAP_RADIUS_M=5000

# --- Google Roads snapping (Phase 2) -------------------------------------
# Consulted only when a coordinate snapped further than 80 m from a road, and
# only ever taken when Google's answer is CLOSER than the routing provider's.
# A gap in Google's rural coverage can therefore cost a missed improvement, but
# can never wrongly refuse a trip.
#
# Requires the Roads API to be enabled on the Google Cloud project, and a
# server key (falls back to GOOGLE_ROUTES_API_KEY, then
# GOOGLE_MAPS_SERVER_API_KEY). Leave this false until Google's road graph has
# been compared against what a tricycle can really use in Basey.
ROUTING_ROADS_SNAP_ENABLED=false
GOOGLE_ROADS_API_KEY=
ROUTING_GOOGLE_ROADS_TIMEOUT_MS=3500

# --- Valhalla, self-hosted routing engine (Phase 4) -----------------------
# Optional. With these unset every quote uses the cloud providers exactly as
# before, so the app can be deployed before the tiles exist.
#
# Turning it on takes BOTH of these AND selecting "Valhalla (self-hosted)" in
# Admin -> Settings -> Routing. The cloud providers stay behind it as fallbacks.
# See scripts/build-valhalla-tiles.sh for the tile build.
ROUTING_VALHALLA_ENABLED=false
ROUTING_VALHALLA_URL=http://farecheck_valhalla:8002
ROUTING_VALHALLA_TIMEOUT_MS=4000

# --- Terrain gate (Phase 3) ----------------------------------------------
# Reads an elevation profile along the quoted route and records the steepest
# sustained climb. Terrain decides ROUTE VALIDITY only; it never touches the
# fare, because Ordinance 105 prices distance.
#
# Ships observing, not enforcing: vehicle_routing_profiles.enforceGradeGate is
# false for every vehicle type until the thresholds have been calibrated. The
# elevation data Google serves over Basey is ~153 m resolution on roads and
# ~611 m inland, far coarser than the 30 m the seeded 12%/25% limits were
# reasoned about, so they need real trips behind them before they refuse one.
#
# Falls back to GOOGLE_ROUTES_API_KEY, then GOOGLE_MAPS_SERVER_API_KEY.
# Requires Elevation API on the key's API-restrictions list.
ROUTING_TERRAIN_ENABLED=false
GOOGLE_ELEVATION_API_KEY=
ROUTING_ELEVATION_TIMEOUT_MS=4000

# App Configuration
NODE_ENV=development

# Secret for the Vercel Cron sweep (GET /api/admin/sweep/stale-trips).
# Set the same value in Vercel project env vars; Vercel sends it as
# `Authorization: Bearer <CRON_SECRET>` on scheduled runs. If unset, the cron
# endpoint returns 401 (admin POST sweep still works).
CRON_SECRET=your-cron-secret-here

# Email Service Configuration (for OTP Password Reset)
# Provider priority: BREVO_API_KEY > RESEND_API_KEY > dev console.
#
# Brevo (recommended free option — 300 emails/day, no domain needed):
#   1. Sign up free at https://www.brevo.com
#   2. Settings > Senders & IP > add and VERIFY a sender email (your Gmail works)
#   3. Settings > SMTP & API > API Keys > create a key (starts with "xkeysib-")
#   4. Set BREVO_API_KEY below and EMAIL_FROM to the verified sender.
BREVO_API_KEY=your_brevo_api_key_here

# Resend (alternative — requires a verified DOMAIN for production)
# Sign up at: https://resend.com (Free tier: 3,000 emails/month)
RESEND_API_KEY=your_resend_api_key_here

# Email sender address. Must be a Brevo-verified sender (or Resend-verified domain).
# Format with display name: "Basey FareCheck <noreply@yourdomain.com>"
# onboarding@resend.dev only works in dev-console mode, never in production.
EMAIL_FROM=Basey FareCheck <your_verified_sender@example.com>

# Note: If no provider key is set (dev only), OTP codes are logged to the server console.
